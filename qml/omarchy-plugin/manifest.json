{
  "schemaVersion": 1,
  "id": "local.omarchy-ai-bar",
  "name": "Omarchy AI Bar",
  "version": "0.1.0",
  "author": "Omarchy AI Bar contributors",
  "description": "AI provider usage, quota, reset, and cost monitoring",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omarchy AI Bar",
    "description": "AI provider usage and quota status",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "barDisplay": "AI and usage",
      "preferredProvider": "Highest usage",
      "usageDirection": "Used",
      "showUnavailable": true,
      "showResetTimes": true,
      "warningThreshold": 90
    },
    "schema": [
      {
        "key": "barDisplay",
        "type": "enum",
        "label": "Bar display",
        "options": [
          "AI and usage",
          "Provider and usage",
          "Usage only",
          "Icon only"
        ],
        "defaultValue": "AI and usage"
      },
      {
        "key": "preferredProvider",
        "type": "enum",
        "label": "Bar provider",
        "options": [
          "Highest usage",
          "Abacus AI",
          "ai&",
          "Alibaba Coding Plan",
          "Alibaba Token Plan",
          "Amp",
          "Antigravity",
          "Augment",
          "Azure OpenAI",
          "AWS Bedrock",
          "Chutes",
          "Claude",
          "ClawRouter",
          "ClinePass",
          "Codebuff",
          "Codex",
          "Command Code",
          "Copilot",
          "Crof",
          "Cursor",
          "Deepgram",
          "DeepInfra",
          "DeepSeek",
          "Devin",
          "Doubao",
          "Droid",
          "ElevenLabs",
          "Fireworks",
          "Gemini",
          "Grok",
          "Groq",
          "IBM Bob",
          "JetBrains AI",
          "Kilo",
          "Kimi Code",
          "Kiro",
          "LiteLLM",
          "LLM Proxy",
          "LongCat",
          "Manus",
          "MiniMax",
          "Mistral",
          "Moonshot",
          "Neuralwatt",
          "Notion AI",
          "Ollama",
          "OpenAI",
          "OpenCode",
          "OpenCode Go",
          "OpenRouter",
          "Perplexity",
          "Poe",
          "Qoder",
          "Qwen Cloud",
          "Sakana AI",
          "StepFun",
          "sub2api",
          "Synthetic",
          "T3 Chat",
          "Venice",
          "Vertex AI",
          "Warp",
          "Wayfinder",
          "Windsurf",
          "xAI",
          "Xiaomi MiMo",
          "z.ai Coding Plan",
          "Zed",
          "ZenMux",
          "ZoomMate"
        ],
        "defaultValue": "Highest usage"
      },
      {
        "key": "usageDirection",
        "type": "enum",
        "label": "Usage direction",
        "options": [
          "Used",
          "Remaining"
        ],
        "defaultValue": "Used"
      },
      {
        "key": "showUnavailable",
        "type": "boolean",
        "label": "Show providers that need setup",
        "defaultValue": true
      },
      {
        "key": "showResetTimes",
        "type": "boolean",
        "label": "Show reset times",
        "defaultValue": true
      },
      {
        "key": "warningThreshold",
        "type": "integer",
        "label": "Warning threshold (percent used)",
        "min": 50,
        "max": 100,
        "step": 5,
        "defaultValue": 90
      }
    ]
  }
}
