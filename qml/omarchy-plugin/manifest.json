{
  "schemaVersion": 1,
  "id": "local.omarchy-ai-bar",
  "name": "Omarchy AI Bar",
  "version": "0.4.0",
  "author": "Omarchy AI Bar contributors",
  "description": "AI provider usage, quota, reset, and cost monitoring",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omarchy AI Bar",
    "description": "AI provider usage and quota status",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "barDisplay": "AI and usage",
      "preferredProvider": "Highest usage",
      "usageDirection": "Used",
      "showResetTimes": true,
      "paceVisible": true,
      "quotaWarningMarkersVisible": true,
      "workdayTicksVisible": true,
      "showOptionalCreditsAndExtraUsage": true,
      "quotaWarningsEnabled": true,
      "hidePersonalInfo": false,
      "showDashboardActions": false,
      "showProviderDetails": false,
      "showActionSection": false,
      "panelHeight": 680,
      "warningThreshold": 90,
      "codexAccountLayout": "Tabs"
    },
    "schema": [
      {
        "key": "barDisplay",
        "type": "enum",
        "label": "Bar display",
        "options": [
          "AI and usage",
          "Provider and usage",
          "Usage only",
          "Icon only"
        ],
        "defaultValue": "AI and usage"
      },
      {
        "key": "preferredProvider",
        "type": "enum",
        "label": "Bar provider",
        "options": [
          "Highest usage",
          "Abacus AI",
          "ai&",
          "Alibaba Coding Plan",
          "Alibaba Token Plan",
          "Amp",
          "Antigravity",
          "Augment",
          "Azure OpenAI",
          "AWS Bedrock",
          "Chutes",
          "Claude",
          "ClawRouter",
          "ClinePass",
          "Codebuff",
          "Codex",
          "Command Code",
          "Copilot",
          "Crof",
          "Cursor",
          "Deepgram",
          "DeepInfra",
          "DeepSeek",
          "Devin",
          "Doubao",
          "Droid",
          "ElevenLabs",
          "Fireworks",
          "Gemini",
          "Grok",
          "Groq",
          "IBM Bob",
          "JetBrains AI",
          "Kilo",
          "Kimi Code",
          "Kiro",
          "LiteLLM",
          "LLM Proxy",
          "LongCat",
          "Manus",
          "MiniMax",
          "Mistral",
          "Moonshot",
          "Neuralwatt",
          "Notion AI",
          "Ollama",
          "OpenAI",
          "OpenCode",
          "OpenCode Go",
          "OpenRouter",
          "Perplexity",
          "Poe",
          "Qoder",
          "Qwen Cloud",
          "Sakana AI",
          "StepFun",
          "sub2api",
          "Synthetic",
          "T3 Chat",
          "Venice",
          "Vertex AI",
          "Warp",
          "Wayfinder",
          "Windsurf",
          "xAI",
          "Xiaomi MiMo",
          "z.ai Coding Plan",
          "Zed",
          "ZenMux",
          "ZoomMate"
        ],
        "defaultValue": "Highest usage"
      },
      {
        "key": "usageDirection",
        "type": "enum",
        "label": "Usage direction",
        "options": [
          "Used",
          "Remaining"
        ],
        "defaultValue": "Used"
      },
      {
        "key": "showResetTimes",
        "type": "boolean",
        "label": "Show reset times",
        "defaultValue": true
      },
      {
        "key": "paceVisible",
        "type": "boolean",
        "label": "Show pace forecasts",
        "defaultValue": true
      },
      {
        "key": "quotaWarningMarkersVisible",
        "type": "boolean",
        "label": "Show quota warning markers",
        "defaultValue": true
      },
      {
        "key": "workdayTicksVisible",
        "type": "boolean",
        "label": "Show weekly workday ticks",
        "defaultValue": true
      },
      {
        "key": "showOptionalCreditsAndExtraUsage",
        "type": "boolean",
        "label": "Show credits and extra usage",
        "defaultValue": true
      },
      {
        "key": "hidePersonalInfo",
        "type": "boolean",
        "label": "Hide personal information",
        "defaultValue": false
      },
      {
        "key": "showDashboardActions",
        "type": "boolean",
        "label": "Show dashboard actions",
        "defaultValue": false
      },
      {
        "key": "showProviderDetails",
        "type": "boolean",
        "label": "Show provider detail actions",
        "defaultValue": false
      },
      {
        "key": "showActionSection",
        "type": "boolean",
        "label": "Show menu action section",
        "defaultValue": false
      },
      {
        "key": "panelHeight",
        "type": "integer",
        "label": "Menu height (pixels)",
        "min": 420,
        "max": 1600,
        "step": 20,
        "defaultValue": 680
      },
      {
        "key": "quotaWarningsEnabled",
        "type": "boolean",
        "label": "Desktop quota warnings",
        "defaultValue": true
      },
      {
        "key": "warningThreshold",
        "type": "integer",
        "label": "Warning threshold (percent used)",
        "min": 50,
        "max": 100,
        "step": 5,
        "defaultValue": 90
      },
      {
        "key": "codexAccountLayout",
        "type": "enum",
        "label": "Codex account layout",
        "options": [
          "Tabs",
          "List"
        ],
        "defaultValue": "Tabs"
      }
    ]
  }
}
