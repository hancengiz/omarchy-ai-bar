# Maintainer: Cengiz Han <cengiz@cengizhan.com>

pkgname=omarchy-ai-bar
pkgver=0.3.0
pkgrel=1
pkgdesc='Omarchy-native AI provider usage, quota, cost, and session monitoring'
arch=('x86_64')
url='https://github.com/hancengiz/omarchy-ai-bar'
license=('MIT')
options=('!lto' '!debug')
depends=(
  'dbus'
  'gcc-libs'
  'glibc'
  'libnotify'
  'omarchy'
  'qt6-declarative'
  'quickshell'
  'sqlite'
)
makedepends=('cargo')
install=omarchy-ai-bar.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('0f4f40303bf95f288095467e3a12063240ca0b15bcea657802fffd0c5fe1745e')

_oab_resolve_remap_path() {
  local label=$1 input=$2 resolved=''
  [[ -n $input ]] || {
    printf 'PKGBUILD: %s path is empty\n' "$label" >&2
    return 1
  }
  case $input in
  *$'\n'* | *$'\r'* | *$'\t'* | *$'\x1f'* | *=*)
    printf 'PKGBUILD: %s path contains a character unsupported by compiler prefix maps\n' \
      "$label" >&2
    return 1
    ;;
  esac
  resolved=$(realpath -m -- "$input") || return 1
  [[ $resolved == /* && $resolved != / ]] || {
    printf 'PKGBUILD: %s path is unsafe\n' "$label" >&2
    return 1
  }
  printf '%s\n' "$resolved"
}

_oab_resolve_logical_remap_path() {
  local label=$1 input=$2 resolved=''
  [[ -n $input ]] || {
    printf 'PKGBUILD: %s path is empty\n' "$label" >&2
    return 1
  }
  case $input in
  *$'\n'* | *$'\r'* | *$'\t'* | *$'\x1f'* | *=*)
    printf 'PKGBUILD: %s path contains a character unsupported by compiler prefix maps\n' \
      "$label" >&2
    return 1
    ;;
  esac
  resolved=$(realpath -ms -- "$input") || return 1
  [[ $resolved == /* && $resolved != / ]] || {
    printf 'PKGBUILD: %s path is unsafe\n' "$label" >&2
    return 1
  }
  printf '%s\n' "$resolved"
}

_oab_append_encoded_rustflag() {
  local output_name=$1 flag=$2 current=''
  current=${!output_name-}
  [[ -z $current ]] || current+=$'\x1f'
  current+=$flag
  printf -v "$output_name" '%s' "$current"
}

_oab_append_native_flag() {
  local output_name=$1 flag=$2 current='' quoted=''
  current=${!output_name-}
  printf -v quoted '%q' "$flag"
  [[ -z $current ]] || current+=' '
  current+=$quoted
  printf -v "$output_name" '%s' "$current"
}

_oab_build_paths() {
  local output_name=$1 source_root='' cargo_home_input=''
  local cargo_home='' cargo_home_logical=''
  source_root=$(pwd -P) || return 1
  cargo_home_input=${CARGO_HOME:-}
  if [[ -z $cargo_home_input ]]; then
    [[ -n ${HOME:-} ]] || {
      printf 'PKGBUILD: neither CARGO_HOME nor HOME is set\n' >&2
      return 1
    }
    cargo_home_input=$HOME/.cargo
  fi
  cargo_home=$(_oab_resolve_remap_path 'Cargo home' "$cargo_home_input") || return 1
  cargo_home_logical=$(
    _oab_resolve_logical_remap_path 'Cargo home' "$cargo_home_input"
  ) || return 1
  source_root=$(_oab_resolve_remap_path 'source root' "$source_root") || return 1

  local -a resolved_paths=("$cargo_home_logical")
  if [[ $cargo_home != "$cargo_home_logical" ]]; then
    resolved_paths+=("$cargo_home")
  fi
  resolved_paths+=("$source_root")
  local -n output=$output_name
  output=("${resolved_paths[@]}")
}

_oab_run_cargo_with_remaps() {
  local encoded_rustflags='' caller_rustflags='' caller_rustflag=''
  local cflags=${CFLAGS:-} cxxflags=${CXXFLAGS:-} private_build_path=''
  local native_destination=''
  local -a caller_rustflag_words=() private_build_paths=()
  _oab_build_paths private_build_paths || return 1

  if [[ ${CARGO_ENCODED_RUSTFLAGS+x} ]]; then
    encoded_rustflags=$CARGO_ENCODED_RUSTFLAGS
  else
    caller_rustflags=${RUSTFLAGS:-}
    caller_rustflags=${caller_rustflags//$'\n'/ }
    caller_rustflags=${caller_rustflags//$'\r'/ }
    read -r -a caller_rustflag_words <<<"$caller_rustflags"
    for caller_rustflag in "${caller_rustflag_words[@]}"; do
      _oab_append_encoded_rustflag encoded_rustflags "$caller_rustflag"
    done
  fi

  for private_build_path in "${private_build_paths[@]}"; do
    if [[ $private_build_path == "${private_build_paths[-1]}" ]]; then
      native_destination="/usr/src/debug/$pkgname-$pkgver"
    else
      native_destination='/usr/src/debug/cargo-home'
    fi
    _oab_append_encoded_rustflag encoded_rustflags \
      "--remap-path-prefix=$private_build_path=$native_destination"
    _oab_append_native_flag cflags \
      "-ffile-prefix-map=$private_build_path=$native_destination"
    _oab_append_native_flag cxxflags \
      "-ffile-prefix-map=$private_build_path=$native_destination"
  done

  CARGO_ENCODED_RUSTFLAGS="$encoded_rustflags" \
    CC_SHELL_ESCAPED_FLAGS=1 \
    CFLAGS="$cflags" \
    CXXFLAGS="$cxxflags" \
    CARGO_TARGET_DIR=target \
    cargo "$@"
}

_oab_verify_binary_path_privacy() {
  local binary=$1 private_build_path=''
  local -a private_build_paths=()
  [[ -f $binary ]] || return 1
  _oab_build_paths private_build_paths || return 1
  for private_build_path in "${private_build_paths[@]}"; do
    if LC_ALL=C grep -aFq -- "$private_build_path" "$binary"; then
      printf 'PKGBUILD: release executable contains an unremapped private build path\n' >&2
      return 1
    fi
  done
}

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  _oab_run_cargo_with_remaps \
    build --release --locked --frozen --package omarchy-ai-bar
  _oab_verify_binary_path_privacy target/release/omarchy-ai-bar
}

check() {
  cd "$pkgname-$pkgver"
  _oab_run_cargo_with_remaps test --workspace --release --locked --frozen
  omarchy plugin validate qml/omarchy-plugin
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/omarchy-ai-bar \
    "$pkgdir/usr/bin/omarchy-ai-bar"
  install -dm755 "$pkgdir/usr/share/omarchy-ai-bar/omarchy-plugin"
  cp -a -- qml/omarchy-plugin/. \
    "$pkgdir/usr/share/omarchy-ai-bar/omarchy-plugin/"

  install -Dm644 packaging/systemd/omarchy-ai-bar.service \
    "$pkgdir/usr/lib/systemd/user/omarchy-ai-bar.service"
  install -Dm644 packaging/desktop/org.omarchy_ai_bar.App.desktop \
    "$pkgdir/usr/share/applications/org.omarchy_ai_bar.App.desktop"
  install -Dm644 packaging/metainfo/org.omarchy_ai_bar.App.metainfo.xml \
    "$pkgdir/usr/share/metainfo/org.omarchy_ai_bar.App.metainfo.xml"
  install -Dm644 packaging/release/org.omarchy_ai_bar.App.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.omarchy_ai_bar.App.svg"
  install -Dm644 packaging/release/INSTALL.md \
    "$pkgdir/usr/share/doc/omarchy-ai-bar/INSTALL.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/omarchy-ai-bar/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/omarchy-ai-bar/NOTICE"

  install -dm755 \
    "$pkgdir/usr/share/bash-completion/completions" \
    "$pkgdir/usr/share/fish/vendor_completions.d" \
    "$pkgdir/usr/share/zsh/site-functions"
  "$pkgdir/usr/bin/omarchy-ai-bar" completion bash \
    >"$pkgdir/usr/share/bash-completion/completions/omarchy-ai-bar"
  "$pkgdir/usr/bin/omarchy-ai-bar" completion fish \
    >"$pkgdir/usr/share/fish/vendor_completions.d/omarchy-ai-bar.fish"
  "$pkgdir/usr/bin/omarchy-ai-bar" completion zsh \
    >"$pkgdir/usr/share/zsh/site-functions/_omarchy-ai-bar"
}
