#!/bin/sh
set -eu
if [ "$#" -ne 3 ] || [ "$1" != "auth" ] || [ "$2" != "application-default" ] || [ "$3" != "print-access-token" ]; then
  printf '%s\n' 'unexpected arguments' >&2
  exit 64
fi
if [ ! -f "${GOOGLE_APPLICATION_CREDENTIALS:-}" ] || [ ! -d "${CLOUDSDK_CONFIG:-}" ]; then
  printf '%s\n' 'credentials are invalid' >&2
  exit 65
fi
if [ -n "${VERTEX_ENV_LEAK_CANARY+x}" ]; then
  printf '%s\n' 'unexpected inherited environment' >&2
  exit 66
fi
printf '%s\n' 'fixture-vertex-service-token-canary'
